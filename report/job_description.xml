<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="job_description_a4" model="report.paperformat">
    <field name="name">Job Description A4 Landscape</field>
    <field name="default" eval="True"/>
    <field name="format">custom</field>
    <field name="page_height">297</field>
    <field name="page_width">210</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">10</field>
    <field name="margin_bottom">7</field>
    <field name="margin_left">0</field>
    <field name="margin_right">0</field>
    <field name="header_line" eval="True"/>
    <field name="header_spacing">10</field>
    <field name="dpi">100</field>
</record>

    <record id="job_description_report" model="ir.actions.report">
        <field name="name">Job Description</field>
        <field name="model">hr.employee</field>
<!--        <field name="report_type">xlsx</field>-->
                <field name="report_type">qweb-html</field>
        <!--        <field name="report_type">qweb-pdf</field>-->
        <field name="report_name">sd_hr_job.job_description</field>
        <field name="report_file">sd_hr_job.job_description</field>
        <field name="print_report_name">'Job-%s' % object.name </field>
        <field name="paperformat_id" ref="job_description_a4"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
    </record>


</odoo>

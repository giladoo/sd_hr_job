<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="view_hr_job_form_inherit" model="ir.ui.view">
        <field name="name">hr.job.view.form.inherit.sd_hr_job</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" position="inside">
                <button class="oe_stat_button" name="action_job_view"
                        type="object" icon="fa-list-ol">
                    <field string="jobs" name="job_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
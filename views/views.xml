<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="job_description_list" model="ir.ui.view">
        <field name="name">Job Description List</field>
        <field name="model">sd_hr_job.items</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="job_id"/>
                <field name="department_id"/>

            </tree>
        </field>

    </record>

    <record id="job_description_action" model="ir.actions.act_window">
        <field name="name">Job Description</field>
        <field name="res_model">sd_hr_job.items</field>
        <field name="view_mode">tree</field>

    </record>

    <menuitem
            id="sd_job_description"
            name="Job Description"
            parent="hr.menu_config_recruitment"
            action="job_description_action"
            sequence="21"/>

</odoo>
